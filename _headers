# Headers for Netlify Identity
/admin.html
  X-Frame-Options: SAMEORIGIN

# Global headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/admin
  X-Robots-Tag: noindex, nofollow

/admin/*
  X-Robots-Tag: noindex, nofollow

/admin.html
  X-Robots-Tag: noindex, nofollow

/test-*
  X-Robots-Tag: noindex, nofollow

/setup-auto-update.html
  X-Robots-Tag: noindex, nofollow

/index_old.html
  X-Robots-Tag: noindex, nofollow

/ru_old.html
  X-Robots-Tag: noindex, nofollow

/Archive%20(1)/*
  X-Robots-Tag: noindex, nofollow

/content/*
  X-Robots-Tag: noindex, nofollow

/docs/*
  X-Robots-Tag: noindex, nofollow

/scripts/*
  X-Robots-Tag: noindex, nofollow

/netlify/*
  X-Robots-Tag: noindex, nofollow
